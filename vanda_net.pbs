#!/bin/bash
# PBS job for Vanda (NUS HPC): which MPI settings remove the fixed ~15 s cost seen on 2+ nodes.
# 128 ranks on 2 nodes (free cpu_parallel queue), each setting on facebook (exact) and twitter.
#   qsub vanda_net.pbs              output in bc-net.log
#PBS -N bc-net
#PBS -q auto_free
#PBS -l select=2:ncpus=64:mpiprocs=64:mem=200gb
#PBS -l place=scatter:excl
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o bc-net.log
set -uo pipefail
R=$PBS_O_WORKDIR; W=$R/run/${PBS_JOBID%%.*}
mkdir -p "$W" && cp "$R"/*.cpp "$R"/run.sh "$W"/ && ln -sfn "$R"/data "$W"/data && cd "$W"
module purge
module load nvhpc-hpcx-cuda12/26.1
export OMPI_MCA_coll_hcoll_enable=0
./run.sh build > /dev/null
bin/bc_serial data/facebook.el -o ref.fb > /dev/null
NET=192.168.22.0/23
UCX="--mca pml ucx -x UCX_TLS=self,sm,tcp -x UCX_NET_DEVICES=ens6f1 --mca oob_tcp_if_include $NET"
TCP="--mca pml ob1 --mca btl self,vader,tcp --mca btl_tcp_if_include $NET --mca oob_tcp_if_include $NET"
echo "RESULT,version,graph,n,m,k,ranks,threads,batch,load,bcast,compute_max,compute_min,imbalance_wait,reduce,total"
run() {  # label, mpirun options
    local label=$1; shift
    for g in facebook twitter; do
        echo "== $label: $g"
        timeout -k 10 300 mpirun --hostfile "$PBS_NODEFILE" --map-by ppr:64:node --bind-to core -np 128 \
            -x OMP_NUM_THREADS=1 "$@" bin/bc_mpi data/$g.el $([ $g = twitter ] && echo -k 8192) \
            -o out.$label.$g 2>&1 | grep -E "^RESULT|ERROR|rror" | head -5
    done
    bin/validate out.$label.facebook ref.fb | tail -1
}
run ucx            $UCX                                  # as in job 1556004
run ucx_noucc      $UCX --mca coll ^ucc,hcoll            # Open MPI's own collectives instead of UCC
run ucx_preconnect $UCX --mca mpi_preconnect_mpi 1       # open all connections inside MPI_Init
run tcp_noucc      $TCP --mca coll ^ucc,hcoll            # plain TCP, without UCC (the original hang)
echo "== done $(date)"
